# ==============================================================================
# ALPHARECALL - PRODUCTION ENVIRONMENT CONFIGURATION
# Track 1: Markets & Sports Prediction (Tatum x Walrus Hackathon)
# ==============================================================================

# --- TATUM SUI RPC & DATA API GATEWAY ---
# Obtain your free API key at: https://dashboard.tatum.io
# Used for Tatum Data API real-time crypto rate feeds and Sui RPC Gateway.
TATUM_API_KEY=your_tatum_api_key_here

# --- WALRUS MEMORY RELAYER & ACCOUNT CREDENTIALS ---
# Generate your Walrus Memory developer credentials at: https://memory.walrus.xyz/dashboard
# MEMWAL_PRIVATE_KEY: Ed25519 delegate private key (64 hex characters)
# MEMWAL_ACCOUNT_ID: Walrus Memory onchain account object ID (0x...)
MEMWAL_PRIVATE_KEY=your_walrus_ed25519_private_key_here
MEMWAL_ACCOUNT_ID=0x_your_walrus_account_object_id_here

# Walrus Hosted Relayer endpoint (default: https://relayer.memory.walrus.xyz)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Namespace isolation for memory recalls (default: alpharecall)
MEMWAL_NAMESPACE=alpharecall

# --- SECURITY GATES & CRON SETTLEMENT ---
# Bearer secret to protect the /api/resolve automated cron settlement endpoint (fail-closed in prod)
CRON_SECRET=your_optional_cron_bearer_secret_here

# Secret header required for /api/seed in production (x-admin-secret: <ADMIN_SECRET>)
ADMIN_SECRET=your_optional_admin_secret_here

# Guard for public oracle fallback (CoinGecko). Set to "false" in production to strictly resolve via Tatum.
ALLOW_PUBLIC_ORACLE_FALLBACK=false
